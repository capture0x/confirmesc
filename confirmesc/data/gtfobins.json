{
  "_comment": "Curated subset of GTFOBins (https://gtfobins.github.io/) entries relevant to SUID and sudo privilege escalation. Extend freely - keys are binary basenames. 'poc_args' (SUID/sudo context) and 'cap_poc_args' (capability context) are argv lists appended after the binary path; when present, --poc actually runs them and checks the resulting effective uid is 0. Payloads are deliberately read-only (print 'id -u') - no shell is spawned, no file is written, no state changes.",
  "find": {"suid": true, "sudo": true, "capability": true, "poc_args": [".", "-maxdepth", "0", "-exec", "/usr/bin/id", "-u", ";"]},
  "vim": {"suid": true, "sudo": true, "capability": false},
  "vi": {"suid": true, "sudo": true, "capability": false},
